#include <stdio.h>

#define INF 1000000000

int min(int a, int b) {
    return (a < b) ? a : b;
}

int main() {
    int n;
    scanf("%d", &n);

    int cost[n][n];

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);

            if (cost[i][j] == -1) {
                cost[i][j] = INF;
            }
        }
    }

    int totalMasks = 1 << n;

    int dp[totalMasks][n];

    // Initialize DP table
    for (int mask = 0; mask < totalMasks; mask++) {
        for (int i = 0; i < n; i++) {
            dp[mask][i] = INF;
        }
    }

