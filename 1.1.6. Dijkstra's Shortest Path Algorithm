#include <limits.h> 
#include <stdio.h>
#define MAX 20
int V, E;
int graph[MAX][MAX];
#define INFINITY 99999

void dijkstra(int G[MAX][MAX], int n, int startnode) {
	  int distance[MAX];
    int visited[MAX];
    int parent[MAX];
//Roshan Seerwani
    int i, j, count;
    int nextnode;
    int min;

    for (i = 1; i <= n; i++) {
        distance[i] = INFINITY;
        visited[i] = 0;
        parent[i] = -1;
	}

    distance[startnode] = 0;

    for (count = 1; count <= n - 1; count++) {

        min = INFINITY;
        nextnode = -1;

        for (i = 1; i <= n; i++) {
            if (!visited[i] && distance[i] < min) {
                min = distance[i];
                nextnode = i;
			}
        }

} 
